# sable-doctor: PASS/FAIL for every piece a Sable trial or onboard laptop needs.
# shellcheck disable=SC2088,SC2317,SC2329 # "~/..." strings are messages; orca helpers are passed to check()
# Usage: sable-doctor [--trial-dir ~/deployments/trials/<agent>-<first>]
# On a trial Mac it checks the access listed in ~/trial-inputs.env (see sable-setup).
# Exit code = number of FAILs. Never prints secret values.
pass=0; fail=0; warn=0
ok()   { printf '\033[1;32mPASS\033[0m  %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '\033[1;31mFAIL\033[0m  %s\n      fix: %s\n' "$1" "$2"; fail=$((fail+1)); }
note() { printf '\033[1;33mWARN\033[0m  %s\n' "$1"; warn=$((warn+1)); }
have() { command -v "$1" >/dev/null 2>&1; }
check() { # check <label> <fix> <command...>
  label=$1; fix=$2; shift 2
  if "$@" >/dev/null 2>&1; then ok "$label"; else bad "$label" "$fix"; fi
}
orca_project_ok() { # orca_project_ok <clone path>: one deployments project, and nothing registered at $HOME
  clone=$1
  cli=/Applications/Orca.app/Contents/Resources/bin/orca
  s=$(mktemp); r=$(mktemp)
  "$cli" project setups --project github:sable-inc/deployments --host local --json >"$s" || { rm -f "$s" "$r"; return 1; }
  "$cli" repo list --json >"$r" || { rm -f "$s" "$r"; return 1; }
  python3 -I - "$clone" "$s" "$r" <<'PY'
import json, os, sys
clone = os.path.normpath(os.path.expanduser(sys.argv[1])).rstrip("/")
home = os.path.normpath(os.path.expanduser("~")).rstrip("/")
def rows(doc):
    if isinstance(doc, dict):
        for key in ("setups", "projects", "repos", "items"):
            if isinstance(doc.get(key), list): return doc[key]
        if isinstance(doc.get("result"), (dict, list)): return rows(doc["result"])
    return doc if isinstance(doc, list) else []
def entry_path(e):
    for k in ("path", "checkoutPath", "gitRoot", "root"):
        if isinstance(e, dict) and e.get(k):
            return os.path.normpath(os.path.expanduser(e[k])).rstrip("/")
    return ""
setups = [entry_path(e) for e in rows(json.load(open(sys.argv[2]))) if entry_path(e)]
repos = [entry_path(e) for e in rows(json.load(open(sys.argv[3]))) if entry_path(e)]
sys.exit(0 if setups == [clone] and home not in repos and clone != home else 1)
PY
  st=$?
  rm -f "$s" "$r"
  return "$st"
}
sable_is_admin() { # true when whoami JSON on stdin has user.isSableAdmin true. Prints nothing.
  python3 -I -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
u=d.get("user") if isinstance(d, dict) else None
raise SystemExit(0 if isinstance(u, dict) and u.get("isSableAdmin") is True else 1)'
}
orca_ds_place() { # orca_ds_place <workspace|claude> <clone>
  # workspace: the active workspace path is the clone. claude: every Claude tab cwd is the clone.
  # Either check fails on its own. A missing Claude tab does not pass.
  mode=$1
  clone=$2
  cli=/Applications/Orca.app/Contents/Resources/bin/orca
  show=$(mktemp)
  "$cli" worktree show --worktree active --json >"$show" 2>/dev/null || { rm -f "$show"; return 1; }
  python3 -I - "$mode" "$clone" "$show" <<'PY'
import json, os, sys
mode, clone, path = sys.argv[1:]
clone = os.path.normpath(os.path.expanduser(clone)).rstrip("/")
home = os.path.normpath(os.path.expanduser("~")).rstrip("/")
doc = json.load(open(path))
def norm(p):
    return os.path.normpath(os.path.expanduser(p)).rstrip("/") if isinstance(p, str) and p else ""
def walk(node):
    if isinstance(node, dict):
        yield node
        for v in node.values():
            yield from walk(v)
    elif isinstance(node, list):
        for v in node:
            yield from walk(v)
def path_of(e):
    for k in ("path", "cwd", "checkoutPath", "gitRoot", "folderPath"):
        p = norm(e.get(k))
        if p:
            return p
    return ""
rows = [e for e in walk(doc) if isinstance(e, dict)]
ws = ""
for e in rows:
    if e.get("worktreeId") or e.get("workspaceKind") or ("path" in e and ("branch" in e or "repo" in e)):
        p = path_of(e)
        if p:
            ws = p
            break
claude = []
for e in rows:
    kind = str(e.get("agentType") or e.get("agent") or "")
    if "claude" in kind.lower():
        p = path_of(e)
        if p:
            claude.append(p)
if mode == "workspace":
    sys.exit(0 if clone != home and ws == clone else 1)
sys.exit(0 if claude and home not in claude and all(c == clone for c in claude) else 1)
PY
  st=$?
  rm -f "$show"
  return "$st"
}

inputs="$HOME/trial-inputs.env"
input() { sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}.*/\1/p" "$inputs" 2>/dev/null | head -1; }
trial_dir=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --trial-dir) [ "$#" -ge 2 ] || { echo "missing value for $1" >&2; exit 64; }; trial_dir="$2"; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 64 ;;
  esac
done
profile_file=/etc/nix-darwin/local.nix
profile=$(grep -o 'sable.profile *= *"[a-z]*"' "$profile_file" 2>/dev/null | grep -o '"[a-z]*"' | tr -d '"')
# Trial Macs need only the access grokbot listed; other Macs need the GitHub and Sable tools.
email=""; repos=""; agent_path=""; api_keys=""; vercel=""; gcp=""; technical=1; trial_type=""; github_user=""
if [ "$profile" = trial ]; then
  email=$(input TRIAL_EMAIL); repos=$(input REPOS); agent_path=$(input AGENT_PATH)
  api_keys=$(input API_KEYS); vercel=$(input VERCEL); gcp=$(input GCP); trial_type=$(input TRIAL_TYPE)
  github_user=$(input TRIAL_GITHUB_USER)
  [ -n "$github_user" ] || technical=0
  # Only DS checks Sable repos. A missing deployments line is still cloned (trial1).
  if [ "$trial_type" = ds ]; then
    case " $repos " in
      *" sable-inc/deployments"[@\ ]*) ;;
      *) repos="${repos:+$repos }sable-inc/deployments" ;;
    esac
  else
    repos=""; agent_path=""
  fi
  [ -n "$agent_path" ] && [ -z "$trial_dir" ] && trial_dir="$HOME/deployments/$agent_path"
fi
echo "sable-doctor  profile=${profile:-default}  host=$(scutil --get LocalHostName 2>/dev/null || hostname)"
[ "$profile" = trial ] && [ ! -s "$inputs" ] && bad "~/trial-inputs.env present" "ask the Onboarding bot for it"
echo

echo "== machine"
check "arm64" "Apple Silicon Mac required" test "$(uname -m)" = arm64
check "user is sable" "recreate the admin account with short name 'sable'" test "$(id -un)" = sable
check "nix-darwin switched" "cd /etc/nix-darwin && nix run path:.#build-switch" test -L /run/current-system
check "Homebrew" "rerun build-switch" brew --version

echo "== apps"
for app in "Google Chrome" Claude ChatGPT zoom.us "Wispr Flow" Ghostty OrbStack Notion 1Password Granola Linear Orca; do
  check "$app.app" "rerun build-switch" test -d "/Applications/$app.app"
done
[ "$profile" = onboard ] && check "Loom.app" "rerun build-switch" test -d /Applications/Loom.app
if [ "$profile" = trial ]; then
  for app in Figma Canva; do check "$app.app" "rerun build-switch" test -d "/Applications/$app.app"; done
fi
if [ -d "/Applications/Nix Apps/Slack.app" ] || [ -d "$HOME/Applications/Home Manager Apps/Slack.app" ]; then ok "Slack.app"; else bad "Slack.app" "rerun build-switch"; fi
# Cursor is a Homebrew cask in /Applications so its own updater works (not a read-only nix copy).
check "Cursor.app (user-owned, self-updating)" "rerun build-switch" test -d /Applications/Cursor.app
if [ -d "$HOME/Applications/Home Manager Apps/Cursor.app" ] || [ -d "/Applications/Nix Apps/Cursor.app" ]; then bad "Cursor is also a nix store copy" "rerun build-switch to remove it"; fi

echo "== CLIs"
for c in git gh node uv doppler lk; do
  check "$c" "rerun build-switch" have "$c"
done
# Claude Code, Codex, pnpm and bun must be the user's own installs (~/.local/bin), not read-only nix copies,
# so Orca and `claude update` / `codex update` can upgrade them.
for c in claude codex pnpm bun; do
  p=$(command -v "$c" 2>/dev/null || true)
  if [ -z "$p" ]; then bad "$c" "run sable-setup (it installs $c with its own installer)"
  elif in_nix_store "$p"; then bad "$c at $p resolves into the nix store and can't update itself" "run sable-setup, then open a new terminal"
  elif own_install "$c"; then ok "$c is a user-owned install (updates itself)"
  else bad "$c at $p can't update itself" "run sable-setup, then open a new terminal"; fi
done

# >>> devin-desktop
# Devin Desktop is a Homebrew cask (default.nix; it auto-updates and bundles the CLI), for new hires only:
# only the onboard profile installs it; default does not, and a trial Mac must not have it. Sign-in (Devin for Enterprise with the @sable.ai Google account) can't be
# read reliably from outside the app, so there is no sign-in line.
devin_apps_dir=${DEVIN_APPS_DIR:-/Applications}
devin_app_present() { local a; for a in "$devin_apps_dir"/Devin*.app; do [ -d "$a" ] && return 0; done; return 1; }
if [ "$profile" = onboard ]; then
  if devin_app_present; then ok "Devin Desktop installed (updates itself)"
  else bad "Devin Desktop" "rerun build-switch (the devin-desktop cask installs it), then sign in with Devin for Enterprise"; fi
elif [ "$profile" = trial ]; then
  if devin_app_present; then bad "Devin Desktop is not on trial Macs" "rerun build-switch (only the onboard profile has the devin-desktop cask; it removes it elsewhere)"
  else ok "no Devin Desktop (new hires only)"; fi
fi
# <<< devin-desktop

echo "== notifications and agents (nix-config agents.nix, Iru Sable: Notifications)"
np="/Library/Managed Preferences/com.apple.notificationsettings.plist"
for b in com.tinyspeck.slackmacgap:Slack com.stablyai.orca:Orca; do
  check "${b#*:} notifications on (Iru Sable: Notifications)" "assign the Iru profile Sable: Notifications to this Mac's blueprint" \
    sh -c "plutil -convert xml1 -o - '$np' 2>/dev/null | grep -q '<string>${b%%:*}</string>'"
done
ms="/Library/Application Support/ClaudeCode/managed-settings.json"
check "Claude Code managed plugins: pstack + codex review" "rerun build-switch (agents.nix)" \
  sh -c "grep -q '\"pstack@cursor-plugins\": *true' '$ms' && grep -q '\"codex@openai-codex\": *true' '$ms'"
check "Codex admin skills: pstack in /etc/codex/skills" "rerun build-switch (agents.nix)" test -f /etc/codex/skills/architect/SKILL.md
od="$HOME/Library/Application Support/Orca"
orca_json="$od/orca-data.json"
if [ ! -f "$orca_json" ] || ! jq -e '.onboarding.closedAt != null' "$orca_json" >/dev/null 2>&1; then
  bad "Orca onboarding finished" "sable-setup (seeds or repairs Orca onboarding; bump ORCA_FLOW_VERSION if Orca changed the flow)"
else ok "Orca onboarding finished"; fi
if [ "$technical" = 1 ]; then
  # A trial Mac keeps the slot's sign-ins across trials, so a missing one is a regression (FAIL).
  # Elsewhere it is the person's day-one step (WARN until they sign in).
  for a in "Claude Code:claude auth status" "Codex:codex login status"; do
    if ${a#*:} >/dev/null 2>&1; then ok "${a%%:*} signed in"
    elif [ "$profile" = trial ]; then bad "${a%%:*} signed in" "sable-setup (then check the light cleanup kept it: trial-tools KEEP_LOGIN)"
    else note "${a%%:*} not signed in yet: sable-setup"; fi
  done
fi
if [ "$trial_type" = ds ]; then
  d="$HOME/deployments"
  check "Claude Code trusts ~/deployments (DS)" "sable-setup" sh -c "jq -e --arg d '$d' '.projects[\$d].hasTrustDialogAccepted == true' '$HOME/.claude.json'"
  check "Codex trusts ~/deployments (DS)" "sable-setup" grep -qF "[projects.\"$d\"]" "$HOME/.codex/config.toml"
fi
if [ "$profile" = trial ]; then
  echo "== GitHub repository invites"
  # Repo names only. The list command's output is the names; its errors are discarded.
  if ! gh auth status >/dev/null 2>&1; then
    note "gh not signed in; pending sable-inc invites were not checked"
  else
    invite_names=$(mktemp)
    if gh api --paginate /user/repository_invitations --jq '.[] | select(.repository.owner.login == "sable-inc") | select(.repository.full_name | startswith("sable-inc/")) | .repository.full_name' >"$invite_names" 2>/dev/null; then
      if [ -s "$invite_names" ]; then
        bad "no pending sable-inc repository invites" "still pending: $(tr '\n' ' ' <"$invite_names"). sable-accept-invites accepts them at setup and at each Iru check-in."
      else
        ok "no pending sable-inc repository invites"
      fi
    else
      bad "no pending sable-inc repository invites" "could not list /user/repository_invitations. sable-accept-invites accepts sable-inc invites at setup and at each Iru check-in."
    fi
    rm -f "$invite_names"
  fi
fi
if [ "$profile" = trial ]; then
  echo "== DS repo works"
  if [ "$trial_type" != ds ]; then
    echo "skipped (non-DS)"
  else
    # Pass or fail per tool. Command output is discarded so a token is never printed.
    # Status and whoami only: no prompts and no model calls.
    d="$HOME/deployments"
    check "git" "sable-setup (clone ~/deployments; git status and git fetch must work)" \
      sh -c "git -C '$d' status && GIT_TERMINAL_PROMPT=0 git -C '$d' fetch"
    check "gh" "sign in as the slot; gh repo view sable-inc/deployments must work" \
      sh -c "login=\$(gh api user --jq .login); [ \"\$login\" = '$github_user' ] && gh repo view sable-inc/deployments"
    check "Claude Code" "claude auth status, from ~/deployments" \
      sh -c "cd '$d' && claude auth status </dev/null"
    check "Codex" "codex login status, from ~/deployments" \
      sh -c "cd '$d' && codex login status </dev/null"
    check "Cursor" "agent status (or cursor-agent status) from ~/deployments" \
      sh -c "cd '$d' && bin=agent; command -v agent >/dev/null 2>&1 || bin=cursor-agent; \"\$bin\" status --format json </dev/null | jq -e '.isAuthenticated == true'"
    check "Orca project path is ~/deployments, not the home directory" "sable-setup (register the deployments clone, never \$HOME)" \
      orca_project_ok "$d"
    check "Orca active workspace is ~/deployments" "sable-setup (activate the deployments workspace; it must not be \$HOME)" \
      orca_ds_place workspace "$d"
    check "Claude tabs open in ~/deployments" "a Claude tab cwd must be ~/deployments, not \$HOME. A missing tab fails this check." \
      orca_ds_place claude "$d"
    check "Debug session hint in ~/.claude/CLAUDE.md" "sable-setup (user-level hint; the deployments repo is not edited)" \
      grep -q 'sable-debug-session-hint' "$HOME/.claude/CLAUDE.md"
    check "call-feedback-triage skill in ~/deployments" "the skill .claude/skills/call-feedback-triage must be in the deployments checkout" \
      test -e "$d/.claude/skills/call-feedback-triage"
  fi
fi

slot_email() { # sable-trial -> trial@sable.ai, sable-trial1 -> trial1@sable.ai
  host=$(scutil --get LocalHostName 2>/dev/null || true)
  case "$host" in
    sable-trial*) slot=${host#sable-} ;;
    *) return 1 ;;
  esac
  printf '%s@sable.ai\n' "$slot"
}
if [ "$profile" = trial ] && [ "$trial_type" = ds ]; then
  echo "== sable CLI (DS)"
  if sable --version >/dev/null 2>&1; then ok "sable --version"
  else bad "sable --version" "after sable-setup fetches trial-inputs.env, the next Iru check-in writes ~/.bunfig.toml when TRIAL_TYPE=ds. Run sable-setup again after that check-in. It does not clone toolbelt."; fi
  slot_mail=$(slot_email || true)
  whoami_out=$(mktemp)
  if [ -z "$slot_mail" ]; then
    bad "sable whoami: this slot's trial account" "this Mac's name is not sable-trial*"
  elif sable --json whoami >"$whoami_out" 2>/dev/null && python3 -I -c 'import json,sys
d=json.load(open(sys.argv[1])); u=d.get("user") if isinstance(d, dict) else None
got=u.get("email") if isinstance(u, dict) else None
raise SystemExit(0 if got==sys.argv[2] else 1)' "$whoami_out" "$slot_mail"; then
    ok "sable whoami: this slot's trial account"
  else
    bad "sable whoami: this slot's trial account" "must be ${slot_mail}, not any other account. setup runs sable login --device and writes the URL and code to /Library/Logs/sable/sable-login-device.txt. Never copy credentials.json from another machine."
  fi
  rm -f "$whoami_out"
fi
if [ "$profile" = trial ] && [ "$trial_type" != ds ]; then
  echo "== sable CLI (absent)"
  sable_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/sable"
  if have sable || sable --version >/dev/null 2>&1; then
    bad "sable CLI absent" "non-DS slots do not get the CLI. sable-setup runs sable logout and bun remove -g @sable-inc/toolbelt @sable-inc/e2e @sable-inc/wiki."
  else ok "sable CLI absent"; fi
  if [ -e "$sable_cfg" ]; then
    bad "sable CLI config absent" "remove $sable_cfg. Never copy credentials.json from another machine."
  else ok "sable CLI config absent"; fi
  if [ -f "$HOME/.bunfig.toml" ] && grep -q '@sable-inc' "$HOME/.bunfig.toml"; then
    bad "no @sable-inc scope in ~/.bunfig.toml" "sable-setup deletes that scope on a non-DS slot"
  else ok "no @sable-inc scope in ~/.bunfig.toml"; fi
fi

if [ "$technical" = 1 ]; then
echo "== GitHub + npm"
check "gh auth status" "gh auth login --web" gh auth status
check "gh token can read packages" "gh auth refresh -s read:packages" sh -c "gh auth status 2>&1 | grep -q read:packages"
check "NPM_TOKEN set (value not shown)" "open a new terminal; the profile exports it from gh auth token" test -n "${NPM_TOKEN:-}"
check "@sable-inc registry in ~/.npmrc" "npm config set @sable-inc:registry https://npm.pkg.github.com" grep -q '@sable-inc:registry' "$HOME/.npmrc"
# shellcheck disable=SC2016 # matches the literal ${NPM_TOKEN} reference npm expands at run time
check "npm auth reads NPM_TOKEN" "npm config set '//npm.pkg.github.com/:_authToken' '\${NPM_TOKEN}'" grep -q 'npm.pkg.github.com/:_authToken=${NPM_TOKEN}' "$HOME/.npmrc"
fi

if [ "$technical" = 1 ] && { [ "$profile" != trial ] || [ "$trial_type" = ds ]; }; then
echo "== Sable tools"
if have sable; then
  ok "sable CLI installed ($(sable --version 2>/dev/null | head -1))"
  check "sable doctor" "sable update && sable doctor" sable doctor
  if sable --json whoami 2>/dev/null | grep -Eqi '"orgName": *"[^"]*trial'; then ok "sable whoami: Trials org"
  elif [ "$profile" = trial ]; then bad "sable whoami: Trials org" "sable login, then ask an engineer for a Trials org invite"
  else note "sable whoami does not mention Trials (fine outside a trial)"; fi
else bad "sable CLI" "bun add -g @sable-inc/toolbelt"; fi
fi
if [ "$technical" = 1 ] && { [ "$profile" != trial ] || [ "$trial_type" = ds ]; }; then
if have sablebrowse; then
  ok "SableBrowse installed"
  check "sablebrowse doctor" "sablebrowse setup" sablebrowse doctor
else bad "SableBrowse" "npm install -g @sable-inc/sablebrowse && sablebrowse setup"; fi
if ls -d "$HOME"/Library/Application\ Support/Google/Chrome/*/Extensions/ildldnmbjlkbomodicckikcenamaabfj >/dev/null 2>&1; then ok "SableBrowse Chrome extension"; else bad "SableBrowse Chrome extension" "install ildldnmbjlkbomodicckikcenamaabfj from the Chrome Web Store"; fi
fi
if ls -d "$HOME"/Library/Application\ Support/Google/Chrome/*/Extensions/aeblfdkhhhdcdjpifhhbdiojplfjncoa >/dev/null 2>&1; then ok "1Password Chrome extension"; else bad "1Password Chrome extension" "Iru installs it with the Chrome profile; open Chrome once, or add it from the Chrome Web Store"; fi

for spec in $repos; do
  repo="${spec%@*}"; branch=""; [ "$spec" != "$repo" ] && branch="${spec#*@}"; dir="$HOME/${repo##*/}"
  [ -n "${printed_repos:-}" ] || { echo "== repos"; printed_repos=1; }
  check "$repo cloned to ~/${repo##*/}" "sable-setup" sh -c "git -C '$dir' remote get-url origin | grep -q '$repo'"
  [ -z "$branch" ] || check "~/${repo##*/} on $branch" "git -C $dir checkout $branch" test "$(git -C "$dir" branch --show-current 2>/dev/null)" = "$branch"
done

if [ -n "$trial_dir" ]; then
  echo "== trial agent"
  check "trial folder exists" "check AGENT_PATH in ~/trial-inputs.env" test -d "$trial_dir"
  if have sable && [ -d "$trial_dir" ]; then
    check "sable build" "cd $trial_dir && sable build" sh -c "cd '$trial_dir' && sable build"
    check "sable lint" "cd $trial_dir && sable lint" sh -c "cd '$trial_dir' && sable lint"
  fi
  if [ -f "$HOME/TRIAL_PROMPT.md" ]; then
    if grep -Eq 'agt_X{4,}|agt_\.\.\.|<[A-Z_]+>|\{\{[A-Z_]+\}\}|TODO' "$HOME/TRIAL_PROMPT.md"; then bad "TRIAL_PROMPT.md has no placeholders" "sable-setup"
    else ok "TRIAL_PROMPT.md filled in"; fi
  else bad "TRIAL_PROMPT.md" "sable-setup"; fi
fi

if [ "$profile" = trial ] && [ -n "$api_keys$vercel$gcp" ]; then
  echo "== trial access"
  if [ "$api_keys" = yes ]; then
    for key in ANTHROPIC_API_KEY OPENAI_API_KEY; do
      check "$key in the Keychain (value not shown)" "sable-setup" security find-generic-password -a sable -s "$key"
    done
  fi
  if [ "$vercel" = yes ]; then
    check "vercel CLI" "npm install -g vercel" have vercel
    check "vercel signed in" "vercel login" vercel whoami
  fi
  [ "$gcp" = yes ] && check "gcloud active account is $email" "gcloud auth login $email" sh -c "gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | grep -qxF '$email'"
fi

echo "== privacy permissions (check by hand if unsure)"
note "mic / camera / screen recording for Chrome, Zoom, Wispr Flow: System Settings > Privacy & Security (cannot be read without MDM)"

echo
echo "summary: $pass PASS, $fail FAIL, $warn WARN"
exit "$fail"
